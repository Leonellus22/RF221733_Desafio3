@model List<PostulacionDto>
@{
    ViewData["Title"] = "Monitoreo de postulaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Monitoreo de postulaciones</h1>
    <form asp-action="Index" method="get" class="d-flex">
        <select name="estado" class="form-select me-2" asp-items="Html.GetEnumSelectList<EstadoPostulacion>()">
            <option value="">Todos los estados</option>
        </select>
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </form>
</div>

<div class="row mb-3">
    @foreach (var estado in Enum.GetValues<EstadoPostulacion>())
    {
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <span class="badge @EstiloEstado.Clase(estado)">@estado.ObtenerNombre()</span>
                    <div class="fs-3">@Model.Count(p => p.Estado == estado)</div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay postulaciones registradas.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Candidato</th>
                <th>Plaza</th>
                <th>Institución</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NombreCandidato<br /><small class="text-muted">@item.EmailCandidato</small></td>
                    <td><a asp-controller="Plazas" asp-action="Postulaciones" asp-route-id="@item.IdPlaza">@item.TituloPlaza</a></td>
                    <td>@item.Institucion</td>
                    <td>@item.FechaPostulacion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge @EstiloEstado.Clase(item.Estado)">@item.Estado.ObtenerNombre()</span></td>
                    <td>@item.Observaciones</td>
                </tr>
            }
        </tbody>
    </table>
}
