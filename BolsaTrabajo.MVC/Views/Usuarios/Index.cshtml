@model List<UsuarioDto>
@{
    ViewData["Title"] = "Usuarios y roles";
    var roles = (List<RolDto>)ViewBag.Roles;
    var idActual = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Usuarios y roles</h1>
    <a asp-action="Create" class="btn btn-primary">Crear usuario</a>
</div>

@* Resumen de usuarios por rol; cada tarjeta filtra el listado *@
<div class="row mb-3">
    @foreach (var rol in roles)
    {
        <div class="col-md-4">
            <a asp-action="Index" asp-route-rol="@rol.Nombre" class="text-decoration-none">
                <div class="card text-center @(ViewBag.Rol == rol.Nombre ? "border-primary" : "")">
                    <div class="card-body">
                        <div class="text-muted">@rol.Nombre</div>
                        <div class="fs-3">@rol.TotalUsuarios</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
@if (!string.IsNullOrEmpty(ViewBag.Rol as string))
{
    <p>Mostrando rol <strong>@ViewBag.Rol</strong>. <a asp-action="Index">Ver todos</a></p>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreCompleto</td>
                <td>@item.Email</td>
                <td>@item.Telefono</td>
                <td>
                    @if (item.Id == idActual)
                    {
                        <span class="badge bg-primary">@item.Rol</span> <small class="text-muted">(usted)</small>
                    }
                    else
                    {
                        <form asp-action="CambiarRol" asp-route-id="@item.Id" method="post" class="d-flex gap-1">
                            <select name="rol" class="form-select form-select-sm" style="width:auto">
                                @foreach (var rol in Roles.Todos)
                                {
                                    <option value="@rol" selected="@(rol == item.Rol)">@rol</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Cambiar rol</button>
                        </form>
                    }
                </td>
                <td>
                    @if (item.Id != idActual)
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
