@model PlazaDto
@{
    ViewData["Title"] = Model.Titulo;
    var yaPostulado = ViewBag.YaPostulado as bool? ?? false;
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="h3">@Model.Titulo</h1>
                <h2 class="h5 text-muted">@Model.Institucion</h2>
            </div>
            <span class="badge @EstiloEstado.Clase(Model.Estado) fs-6">@Model.Estado.ObtenerNombre()</span>
        </div>
        <p class="mt-3" style="white-space: pre-line">@Model.Descripcion</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FechaPublicacion)</dt>
            <dd class="col-sm-9">@Model.FechaPublicacion.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FechaCierre)</dt>
            <dd class="col-sm-9">@Model.FechaCierre.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Publicada por</dt>
            <dd class="col-sm-9">@Model.NombreAgente</dd>
        </dl>
    </div>
    <div class="card-footer">
        @* Acciones según el rol del usuario *@
        @if (User.IsInRole(Roles.Candidato))
        {
            if (yaPostulado)
            {
                <span class="text-success fw-semibold">Ya se postuló a esta plaza.</span>
                <a asp-controller="Postulaciones" asp-action="MisPostulaciones" class="btn btn-outline-primary btn-sm ms-2">Ver mis postulaciones</a>
            }
            else if (Model.Estado == EstadoPlaza.Abierta)
            {
                <form asp-controller="Postulaciones" asp-action="Postular" method="post" class="d-inline">
                    <input type="hidden" name="idPlaza" value="@Model.IdPlaza" />
                    <button type="submit" class="btn btn-success">Postularme</button>
                </form>
            }
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", new { id = Model.IdPlaza })" class="btn btn-success">Inicie sesión para postularse</a>
        }
        else if (User.IsInRole(Roles.Agente) || User.IsInRole(Roles.Administrador))
        {
            <a asp-action="Postulaciones" asp-route-id="@Model.IdPlaza" class="btn btn-primary">Ver postulaciones</a>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>
